---
interface Props { title: string }
const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: #020617; color: #e2e8f0; min-height: 100vh; display: flex; }

    .sidebar {
      width: 220px; min-height: 100vh; background: rgba(15,23,42,0.9);
      border-right: 1px solid rgba(255,255,255,0.06);
      display: flex; flex-direction: column; padding: 1.5rem 1rem; flex-shrink: 0;
    }
    .sidebar-brand { font-size: 0.9rem; font-weight: 700; color: #fff; margin-bottom: 0.25rem; padding: 0 0.5rem; }
    .sidebar-sub   { font-size: 0.7rem; color: #475569; text-transform: uppercase; letter-spacing: 0.08em; padding: 0 0.5rem; margin-bottom: 2rem; }
    .nav-label     { font-size: 0.65rem; font-weight: 600; color: #334155; text-transform: uppercase; letter-spacing: 0.1em; padding: 0 0.5rem; margin-bottom: 0.5rem; }
    .nav a {
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.55rem 0.75rem; border-radius: 0.5rem;
      color: #94a3b8; font-size: 0.875rem; text-decoration: none;
      transition: background 0.15s, color 0.15s;
    }
    .nav a:hover  { background: rgba(255,255,255,0.05); color: #f1f5f9; }
    .nav a.active { background: rgba(0,163,224,0.12); color: #00a3e0; }
    .nav { margin-bottom: auto; }
    .logout-btn {
      width: 100%; padding: 0.55rem 0.75rem; border-radius: 0.5rem;
      background: none; border: 1px solid rgba(255,255,255,0.08);
      color: #64748b; font-size: 0.875rem; cursor: pointer;
      text-align: left; transition: border-color 0.2s, color 0.2s;
    }
    .logout-btn:hover { border-color: #ef4444; color: #f87171; }
    .main { flex: 1; padding: 2.5rem 2rem; max-width: 860px; }

    :global(.form-grid)  { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    :global(.full-width) { grid-column: 1 / -1; }
    :global(.field)      { display: flex; flex-direction: column; gap: 0.35rem; }
    :global(label)       { font-size: 0.75rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.08em; }
    :global(input[type=text]),
    :global(input[type=file]),
    :global(textarea)    {
      padding: 0.6rem 0.85rem;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.5rem; color: #f1f5f9; font-size: 0.9rem; font-family: inherit;
      outline: none; width: 100%; transition: border-color 0.2s;
    }
    :global(input:focus), :global(textarea:focus) { border-color: #00a3e0; }
    :global(textarea)    { resize: vertical; min-height: 100px; }
    :global(.btn-primary) {
      padding: 0.65rem 1.5rem; background: #00a3e0; border: none;
      border-radius: 0.5rem; color: #fff; font-size: 0.9rem; font-weight: 600;
      cursor: pointer; transition: background 0.2s;
    }
    :global(.btn-primary:hover) { background: #0090c7; }
    :global(.btn-danger) {
      padding: 0.4rem 0.8rem; background: none;
      border: 1px solid rgba(239,68,68,0.4); border-radius: 0.5rem;
      color: #f87171; font-size: 0.8rem; cursor: pointer; transition: background 0.2s;
    }
    :global(.btn-danger:hover)  { background: rgba(239,68,68,0.1); }
    :global(.alert-ok)  {
      padding: 0.65rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; margin-bottom: 1.25rem;
      background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); color: #86efac;
    }
    :global(.alert-err) {
      padding: 0.65rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; margin-bottom: 1.25rem;
      background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5;
    }
    :global(.section-card) {
      background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.07);
      border-radius: 1rem; padding: 1.75rem; margin-bottom: 1.5rem;
    }
    :global(.section-heading) {
      font-size: 0.75rem; font-weight: 700; color: #475569;
      text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1.25rem;
    }
    :global(.hint) { font-size: 0.75rem; color: #475569; margin-top: 0.25rem; }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="sidebar-brand">Audrey Derifaj</div>
    <div class="sidebar-sub">Admin</div>

    <p class="nav-label">Manage</p>
    <nav class="nav">
      <a href="/admin"         class={Astro.url.pathname === '/admin'           ? 'active' : ''}>🏠 Dashboard</a>
      <a href="/admin/player"  class={Astro.url.pathname.includes('/player')   ? 'active' : ''}>👤 Player Info</a>
      <a href="/admin/videos"  class={Astro.url.pathname.includes('/videos')   ? 'active' : ''}>🎬 Videos</a>
    </nav>

    <form method="POST" action="/api/logout">
      <button class="logout-btn" type="submit">⎋ Sign out</button>
    </form>
  </aside>

  <main class="main">
    <slot />
  </main>
</body>
</html>
