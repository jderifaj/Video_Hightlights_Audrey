---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import videos from '../../data/videos.json';

const success = Astro.url.searchParams.get('success');
const error   = Astro.url.searchParams.get('error');
---

<AdminLayout title="Videos">
  <h1 class="page-title">Videos</h1>
  <p class="page-sub">Add or remove highlight clips. Each change commits to GitHub and triggers a rebuild.</p>

  {success && <div class="alert-ok">✓ Saved — site rebuild triggered. Changes live in ~2 min.</div>}
  {error   && <div class="alert-err">✗ Action failed. Check GitHub env vars or file size (thumbnails must be under 7 MB).</div>}

  <!-- Current videos -->
  <div class="section-card">
    <p class="section-heading">Current Videos ({videos.length})</p>
    {videos.length === 0 && <p class="empty">No videos yet.</p>}
    <div class="video-list">
      {videos.map(v => (
        <div class="video-row">
          <img src={v.thumb} alt={v.title} class="thumb" onerror="this.src='/favicon.svg'" />
          <div class="video-meta">
            <span class="video-title">{v.title}</span>
            <span class="video-cats">{(v.categories ?? []).join(', ')}</span>
            <span class="video-url">{v.url}</span>
          </div>
          <form method="POST" action="/api/delete-video" class="delete-form">
            <input type="hidden" name="id" value={v.id} />
            <button type="submit" class="btn-danger"
              onclick="return confirm('Remove this video from the list?')">Remove</button>
          </form>
        </div>
      ))}
    </div>
  </div>

  <!-- Add video form -->
  <div class="section-card">
    <p class="section-heading">Add a Video</p>
    <form method="POST" action="/api/add-video" enctype="multipart/form-data">

      <div class="form-grid">
        <div class="field full-width">
          <label for="title">Title</label>
          <input id="title" name="title" type="text" placeholder="Nice Through Ball" required />
        </div>

        <div class="field full-width">
          <label for="categories">Categories</label>
          <input id="categories" name="categories" type="text" placeholder="passing, hustle" />
          <p class="hint">Comma-separated. Matching filter buttons appear automatically.</p>
        </div>

        <div class="field full-width">
          <label for="videoFilename">Video Filename</label>
          <input id="videoFilename" name="videoFilename" type="text" placeholder="myvideo.mp4" required />
          <p class="hint">
            Commit the <code>.mp4</code> file to <code>public/videos/</code> in your repo first,
            then enter its filename here (e.g. <code>myvideo.mp4</code>).
          </p>
        </div>

        <div class="field full-width">
          <label for="thumbnail">Thumbnail Image</label>
          <input id="thumbnail" name="thumbnail" type="file" accept="image/*" />
          <p class="hint">Upload a JPG or PNG (under 7 MB). It will be committed to <code>public/images/</code>.</p>
        </div>
      </div>

      <button type="submit" class="btn-primary" style="margin-top:1rem">Add Video & Commit to GitHub</button>
    </form>
  </div>
</AdminLayout>

<style>
  .page-title  { font-size: 1.5rem; font-weight: 700; color: #fff; margin-bottom: 0.25rem; }
  .page-sub    { font-size: 0.85rem; color: #64748b; margin-bottom: 1.5rem; }
  .empty       { color: #475569; font-size: 0.85rem; }

  .video-list  { display: flex; flex-direction: column; gap: 0.75rem; }
  .video-row   {
    display: flex; align-items: center; gap: 1rem;
    padding: 0.75rem; border-radius: 0.6rem;
    background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06);
  }
  .thumb       { width: 80px; height: 45px; object-fit: cover; border-radius: 0.35rem; flex-shrink: 0; background: #1e293b; }
  .video-meta  { display: flex; flex-direction: column; gap: 0.15rem; flex: 1; min-width: 0; }
  .video-title { font-size: 0.9rem; font-weight: 600; color: #f1f5f9; }
  .video-cats  { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
  .video-url   { font-size: 0.72rem; color: #334155; font-family: monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .delete-form { flex-shrink: 0; }
  code         { background: rgba(255,255,255,0.06); padding: 0.1em 0.35em; border-radius: 0.25rem; font-size: 0.8rem; color: #94a3b8; }
</style>
